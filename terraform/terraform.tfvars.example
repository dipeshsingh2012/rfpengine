project_id       = "rfpengine"
region           = "us-central1"
app_name         = "rfpengine"
credentials_file = "../gcp-key.json"

# Neon PostgreSQL Connection URL
database_url     = "postgresql://neondb_owner:your_password@ep-rapid-truth-...neon.tech/neondb?sslmode=require"

# Algolia Cloud Settings
algolia_app_id     = "YOUR_ALGOLIA_APP_ID"
algolia_api_key    = "YOUR_ALGOLIA_API_KEY"
algolia_index_name = "rfp_knowledge_base"

# Pinecone Serverless Settings
pinecone_index        = "rfp-knowledge-base"
pinecone_cloud        = "aws"
pinecone_region       = "us-east-1"
pinecone_api_key      = ""

# Vertex AI Settings
llm_provider           = "vertexai"
gemini_model           = "gemini-2.5-flash"
vertex_embedding_model = "text-embedding-004"
embedding_dimension    = 768

# CORS Settings
cors_origins = "http://localhost:5173,http://localhost:3000"