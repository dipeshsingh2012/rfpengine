{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rfpengine-api-fwwnzie4dq-uc.a.run.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://rfpengine-api-fwwnzie4dq-uc.a.run.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}