{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rfpengine-api-714049712844.us-central1.run.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://rfpengine-api-714049712844.us-central1.run.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

