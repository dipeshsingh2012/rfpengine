{
  "name": "rfpengine",
  "version": "0.2.0",
  "private": true,
  "description": "Seller-side RFP and questionnaire response assistant",
  "scripts": {
    "prepare": "husky",
    "test": "cd backend && ./.venv/bin/pytest tests -v",
    "test:db": "cd backend && ./.venv/bin/pytest tests/test_postgres_connection.py -v",
    "test:cloud": "cd backend && ./.venv/bin/python scripts/verify_cloud_connections.py",
    "secrets:audit": "cd backend && ./.venv/bin/python scripts/gcp_secrets_sync.py",
    "secrets:sync": "cd backend && ./.venv/bin/python scripts/gcp_secrets_sync.py --sync",
    "db:migrate": "cd backend && python3 -m alembic upgrade head",
    "db:revision": "cd backend && python3 -m alembic revision --autogenerate",
    "tf:init": "cd terraform && terraform init",
    "tf:plan": "cd terraform && terraform plan",
    "tf:apply": "cd terraform && terraform apply"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11"
  }
}
