# Google Cloud Platform & Secret Manager (Optional)
GCP_PROJECT_ID=
GCP_SECRET_MANAGER_ENABLED=false
GCP_SECRET_PREFIX=

# Neon / PostgreSQL Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rfpengine

# OpenAI Settings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# Elasticsearch Settings
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=rfq_knowledge_base
ELASTICSEARCH_VERIFY_CERTS=false

# Pinecone Settings
PINECONE_API_KEY=
PINECONE_INDEX=rfq-knowledge-base
PINECONE_ENVIRONMENT=
PINECONE_HOST=

# CORS & Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=chrome-extension://.*
PORT=8000
