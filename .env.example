# Google Cloud Platform & Vertex AI Settings
GCP_PROJECT_ID=rfpengine
GCP_SECRET_MANAGER_ENABLED=true
GCP_SECRET_PREFIX=rfpengine-
GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json

# Native Vertex AI LLM & Embedding Settings
LLM_PROVIDER=vertexai
GEMINI_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Neon PostgreSQL Connection URL
DATABASE_URL=postgresql://neondb_owner:your_password@ep-rapid-truth-...neon.tech/neondb?sslmode=require

# Elasticsearch / Elastic Cloud Settings
ELASTICSEARCH_URL=https://ba084bb1a22b44618a61af41fbedc84b.us-central1.gcp.cloud.es.io:443
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=rfq_knowledge_base
ELASTICSEARCH_VERIFY_CERTS=true

# Pinecone Serverless Settings
PINECONE_API_KEY=
PINECONE_INDEX=rfq-knowledge-base
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=768

# CORS & Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=chrome-extension://.*
PORT=8000
