{
  "manifest_version": 3,
  "name": "RFQEngine Response Assistant",
  "version": "0.1.0",
  "description": "Scan seller questionnaires, draft grounded answers, and insert approved responses.",
  "permissions": ["sidePanel", "activeTab", "tabs", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://localhost:5173/*", "https://*/*", "http://*/*"],
  "action": { "default_title": "Open RFQEngine" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
